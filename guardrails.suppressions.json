{
  "rules": {
    "@typescript-eslint/no-unused-vars": 2,
    "anti-slop/no-known-value-widening": 1,
    "anti-slop/no-object-parameters": 1,
    "anti-slop/no-reflect-apply": 1,
    "anti-slop/no-shape-in-symbol-names": 16,
    "anti-slop/no-unknown-parameters": 38,
