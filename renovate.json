{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>AntelopeJS/.github:renovate.json5"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The provider modules the backend test harness pins, by name without the @antelopejs scope",
      "managerFilePatterns": [
        "/^packages/dms/src/test/helpers/harness-modules\\.ts$/"
      ],
      "matchStrings": [
        "\"?(?<depName>[a-z][a-z0-9-]*)\"?:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "@antelopejs/{{{depName}}}",
      "datasourceTemplate": "npm"
    }
  ]
}
