{
  // Emit only: the module system goes back to CommonJS so `await import()`
  // keeps compiling to `require()` and the directory-based interface loading
  // keeps working. Type settings belong in tsconfig.json, which is the config
  // the editors and oxlint's type-aware pass read.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false
  }
}
