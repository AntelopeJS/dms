  "Form": {
    "type": "Form",
    "options": {
      "title": "Workspace profile",
      "description": "Shown on invoices and in emails sent to members.",
      "submitLabel": "Save changes",
      "fields": [
        {
          "id": "name",
          "label": "Workspace name",
          "component": {
            "componentName": "dms-input-text",
            "options": {
              "placeholder": "Acme Inc."
            },
            "children": []
          },
          "type": "string"
        },
        {
          "id": "email",
          "label": "Billing email",
          "description": "Invoices are sent here.",
          "component": {
            "componentName": "dms-input-email",
            "options": {
              "placeholder": "billing@acme.io"
            },
            "children": []
          },
          "type": "email"
        },
        {
          "id": "plan",
          "label": "Plan",
          "component": {
            "componentName": "dms-select",
            "options": {
              "items": [
                {
                  "label": "Starter",
                  "value": "starter"
                },
                {
                  "label": "Business",
                  "value": "business"
                },
                {
                  "label": "Enterprise",
                  "value": "enterprise"
                }
              ]
            },
            "children": []
          },
          "type": "select"
        },
        {
          "id": "notifications",
          "label": "Weekly summary",
          "description": "A digest of activity every Monday.",
          "component": {
            "componentName": "dms-switch",
            "options": {},
            "children": []
          },
          "type": "boolean"
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": ["string", "null"]
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["starter", "business", "enterprise"]
              },
              {
                "type": "null"
              }
            ]
          },
          "notifications": {
            "type": ["boolean", "null"]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  },
