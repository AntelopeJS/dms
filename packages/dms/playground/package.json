{
  "name": "playground",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "dmsFrontend": "dist/frontend-module.js",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "pnpm build && node --test dist/prototype-keys.test.js dist/form/demo-forms.test.js checks/client-lint.test.mjs && node --import ./checks/resolve-ts.mjs --test checks/docs-fixtures.test.mjs",
    "lint:client": "cd frontend-vue && ../node_modules/.bin/eslint --config ../checks/client-lint.config.mjs --max-warnings 0 .",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "types:prepare": "ajs dms prepare-types -q --out .frontend-vue-types --layer ../frontend-vue --module frontend-vue --local-package @antelopejs/dms=.. --local-package @antelopejs/interface-dms=../../interface-dms",
    "frontend:build": "ajs dms build",
    "frontend:start": "ajs dms start -b http://127.0.0.1:5010"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.5",
    "@antelopejs/dms-frontend": ">=0.11.11 <0.12.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.5 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.2 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.3 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0",
    "@antelopejs/interface-dms": "workspace:*",
    "zod": "^4.5.0"
  }
}
