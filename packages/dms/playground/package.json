{
  "name": "playground",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "dmsFrontend": "dist/frontend-module.js",
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "pnpm build && node --test dist/prototype-keys.test.js dist/form/demo-forms.test.js && node --import ./checks/resolve-ts.mjs --test checks/docs-fixtures.test.mjs",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "types:prepare": "ajs dms prepare-types -q --out .frontend-vue-types --layer ../frontend-vue --module frontend-vue --local-package @antelopejs/dms=.. --local-package @antelopejs/interface-dms=../../interface-dms",
    "frontend:build": "ajs dms build",
    "frontend:start": "ajs dms start -b http://127.0.0.1:5010"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.0",
    "@antelopejs/dms-frontend": ">=0.11.4 <0.12.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.2 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.0 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.0 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.0 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-dms": "workspace:*",
    "zod": "^3.24.2"
  }
}
