{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "useDefineForClassFields": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
