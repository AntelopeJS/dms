{
  "git": {
    "commitMessage": "chore(release): @antelopejs/dms v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/dms v${version}"
  },
  "hooks": {
    "before:init": ["pnpm lint"],
    "after:bump": [
      "git add CHANGELOG.md",
      "node scripts/docs-catalog.mjs",
      "git add docs-data/blocks.json",
      "node scripts/publish.mjs"
    ]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  }
}
