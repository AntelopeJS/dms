{
  "name": "@antelopejs/dms-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dms.frontend.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "typecheck": "ajs dms verify-source --layer \"$PWD\" --local-package @antelopejs/dms=.. --local-package @antelopejs/interface-dms=../../interface-dms",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "frontend:build": "ajs dms build -b http://127.0.0.1:5010",
    "frontend:start": "ajs dms start -p 3001"
