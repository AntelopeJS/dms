{
  "name": "@antelopejs/interface-dms",
  "version": "0.0.4",
  "description": "Public AntelopeJS interfaces of the DMS: pages, components, permissions, tenancy, auth, notifications and HTML rendering.",
  "keywords": [
    "antelopejs",
    "dms",
    "interface"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {},
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "format": "oxfmt .",
    "prepack": "pnpm run build && pnpm run check:exports",
    "check:exports": "node scripts/check-exports.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "release": "release-it",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "randomstring": "^1.3.1",
    "zod": "~3.24.2",
    "zod-to-json-schema": "~3.24.6"
  },
  "peerDependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-auth": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.3 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-auth": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.3 <1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/randomstring": "^1.3.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/db": {
      "types": "./dist/auth/db/index.d.ts",
      "default": "./dist/auth/db/index.js"
    },
    "./auth/db/models": {
      "types": "./dist/auth/db/models/index.d.ts",
      "default": "./dist/auth/db/models/index.js"
    },
    "./auth/db/tables": {
      "types": "./dist/auth/db/tables/index.d.ts",
      "default": "./dist/auth/db/tables/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "default": "./dist/base/index.js"
    },
    "./base/block-registry": {
      "types": "./dist/base/block-registry/index.d.ts",
      "default": "./dist/base/block-registry/index.js"
    },
    "./base/data-types": {
      "types": "./dist/base/data-types/index.d.ts",
      "default": "./dist/base/data-types/index.js"
    },
    "./base/types": {
      "types": "./dist/base/types/index.d.ts",
      "default": "./dist/base/types/index.js"
    },
    "./data-controllers": {
      "types": "./dist/data-controllers/index.d.ts",
      "default": "./dist/data-controllers/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/models": {
      "types": "./dist/db/models/index.d.ts",
      "default": "./dist/db/models/index.js"
    },
    "./db/tables": {
      "types": "./dist/db/tables/index.d.ts",
      "default": "./dist/db/tables/index.js"
    },
    "./html-render": {
      "types": "./dist/html-render/index.d.ts",
      "default": "./dist/html-render/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts"
    },
    "./dist/auth": {
      "types": "./dist/auth/index.d.ts"
    },
    "./dist/auth/db": {
      "types": "./dist/auth/db/index.d.ts"
    },
    "./dist/auth/db/models": {
      "types": "./dist/auth/db/models/index.d.ts"
    },
    "./dist/auth/db/tables": {
      "types": "./dist/auth/db/tables/index.d.ts"
    },
    "./dist/base": {
      "types": "./dist/base/index.d.ts"
    },
    "./dist/base/block-registry": {
      "types": "./dist/base/block-registry/index.d.ts"
    },
    "./dist/base/data-types": {
      "types": "./dist/base/data-types/index.d.ts"
    },
    "./dist/base/types": {
      "types": "./dist/base/types/index.d.ts"
    },
    "./dist/data-controllers": {
      "types": "./dist/data-controllers/index.d.ts"
    },
    "./dist/db": {
      "types": "./dist/db/index.d.ts"
    },
    "./dist/db/models": {
      "types": "./dist/db/models/index.d.ts"
    },
    "./dist/db/tables": {
      "types": "./dist/db/tables/index.d.ts"
    },
    "./dist/html-render": {
      "types": "./dist/html-render/index.d.ts"
    },
    "./dist/notifications": {
      "types": "./dist/notifications/index.d.ts"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*",
        "dist/*/index.d.ts"
      ],
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
