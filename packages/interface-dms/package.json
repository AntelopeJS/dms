{
  "name": "@antelopejs/interface-dms",
  "version": "0.11.0",
  "description": "Public AntelopeJS interfaces of the DMS: pages, components, permissions, tenancy, auth, notifications and HTML rendering.",
  "keywords": [
    "antelopejs",
    "dms",
    "interface"
  ],
  "homepage": "https://dms.antelopejs.com/docs/interfaces",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms.git",
    "directory": "packages/interface-dms"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "docs",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {},
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "pnpm run build && pnpm run check:exports && pnpm run check:proxies",
    "check:exports": "node scripts/check-exports.mjs",
    "check:proxies": "node scripts/check-proxies.mjs",
    "release": "release-it",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "randomstring": "^1.3.1",
    "zod": "~3.24.2",
    "zod-to-json-schema": "~3.24.6"
  },
  "peerDependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.5.0 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.11 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.4 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-11c035a.tgz",
    "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-94c0812.tgz",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-724ff72.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-fcb0a29.tgz",
    "@antelopejs/interface-file-storage": ">=0.1.4 <1.0.0",
    "@types/node": "^24.0.0",
    "@types/randomstring": "^1.3.0",
    "knip": "^6.34.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/db": {
      "types": "./dist/auth/db/index.d.ts",
      "default": "./dist/auth/db/index.js"
    },
    "./auth/db/models": {
      "types": "./dist/auth/db/models/index.d.ts",
      "default": "./dist/auth/db/models/index.js"
    },
    "./auth/db/tables": {
      "types": "./dist/auth/db/tables/index.d.ts",
      "default": "./dist/auth/db/tables/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "default": "./dist/base/index.js"
    },
    "./base/block-registry": {
      "types": "./dist/base/block-registry/index.d.ts",
      "default": "./dist/base/block-registry/index.js"
    },
    "./base/data-types": {
      "types": "./dist/base/data-types/index.d.ts",
      "default": "./dist/base/data-types/index.js"
    },
    "./base/types": {
      "types": "./dist/base/types/index.d.ts",
      "default": "./dist/base/types/index.js"
    },
    "./data-controllers": {
      "types": "./dist/data-controllers/index.d.ts",
      "default": "./dist/data-controllers/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/models": {
      "types": "./dist/db/models/index.d.ts",
      "default": "./dist/db/models/index.js"
    },
    "./db/tables": {
      "types": "./dist/db/tables/index.d.ts",
      "default": "./dist/db/tables/index.js"
    },
    "./html-render": {
      "types": "./dist/html-render/index.d.ts",
      "default": "./dist/html-render/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
