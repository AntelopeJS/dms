{
  "git": {
    "commitMessage": "chore(release): @antelopejs/interface-dms v${version}",
    "tagName": "interface-v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/interface-dms v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm run build",
      "pnpm --dir ../.. run lint",
      "pnpm run check:exports"
    ],
    "after:bump": [
      "git add CHANGELOG.md",
      "node scripts/raise-dms-range.mjs",
      "pnpm --dir ../.. install --lockfile-only --no-frozen-lockfile",
      "pnpm --dir ../.. run sync",
      "git add ../dms/package.json ../dms/README.md ../../pnpm-lock.yaml"
    ]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true,
    "allowSameVersion": true
  }
}
