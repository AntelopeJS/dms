{
  "git": {
    "commitMessage": "chore(release): @antelopejs/interface-dms-builder v${version}",
    "tagName": "interface-dms-builder-v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/interface-dms-builder v${version}"
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
