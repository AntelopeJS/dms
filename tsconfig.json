{
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "preserve",
    "lib": ["esnext", "dom"],
    "incremental": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
