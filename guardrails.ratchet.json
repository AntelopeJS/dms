{
  "pack": "0.2.18",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 22,
    "antelopejs/no-presence-only-type-guard": 3,
    "anti-slop/no-reflect-apply": 1,
    "anti-slop/no-reflect-get": 2,
    "anti-slop/no-runtime-typeof": 28,
    "typescript/no-base-to-string": 1,
    "typescript/no-unnecessary-type-parameters": 1,
    "typescript/no-unsafe-argument": 58,
    "typescript/no-unsafe-assignment": 147,
    "typescript/no-unsafe-return": 104,
    "typescript/unbound-method": 9
  },
  "oversizeFiles": {}
}
