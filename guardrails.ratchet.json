{
  "pack": "0.2.18",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 5,
    "antelopejs/no-presence-only-type-guard": 3,
    "anti-slop/no-reflect-get": 2,
    "anti-slop/no-runtime-typeof": 8,
    "anti-slop/no-unknown-returns": 1,
    "typescript/no-unnecessary-type-parameters": 1,
    "typescript/no-unsafe-argument": 10,
    "typescript/no-unsafe-assignment": 40,
    "typescript/no-unsafe-return": 30,
    "typescript/unbound-method": 7
  },
  "oversizeFiles": {}
}
