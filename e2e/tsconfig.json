{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["*.ts", "**/*.mjs"],
  "exclude": ["playwright-report", "test-results", "blob-report"]
}
